        "jsCode": "return $input.all().map(item => {\n  const answer = (item.json.output || '').trim();\n  const clean = answer.toLowerCase().replace(/\\u2019/g, \"'\");\n  return {\n    json: {\n      output: answer,\n      answer: answer,\n      answered: !clean.includes(\"i don't know\"),\n      type: 'question'\n    }\n  };\n});"
